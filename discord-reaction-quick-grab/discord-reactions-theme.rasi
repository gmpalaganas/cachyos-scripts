* {

  accent: #2573d8;
  bg: #1b1b1b;
  fg: #f5efe6;
  element-bg: #212121;
  outline: #434343;
  pl-color: #787878;
  scrollbar-color: #46474a;

  background-color: transparent;
  text-color: @fg;
  border-color: @outline;

  font: "Noto Sans 12";
  margin:     0px;
  padding:    0px;
  spacing:    0px;
}

window {
  background-color: @bg;
  border: 0.05em;
  border-radius: 5px;
  width: 25%;
}

prompt, entry, element-text, element-icon {
    vertical-align: 0.5;
}

inputbar {
  border: 0px 0px 2px 0px;
  children:   [ icon-left, entry ];
}

icon-left {
  expand: false;
  size: 16;
  padding: 16px;
  vertical-align: 0.5;
  filename: "file-search-symbolic";
  background-color: @element-bg;
}

entry {
  padding: 16px 16px 16px 0px;
  background-color: @element-bg;
  placeholder: "Search Discord Reaction Images...";
  placeholder-color: @pl-color;
}

scrollbar {
  handle-color: @scrollbar-color;
  border-color: @outline;
  border:0px 0px 0px 0.05em;
}

listview {
  lines: 5;
  scrollbar: true;
  scrollbar-width: 5px;
}

element {

  margin: 8px;
  padding: 8px;
  spacing: 8px;
  background-color: @element-bg;
  border:0.05em;
  border-radius: 5px;
  border-color: @outline;
}

element-text {
  padding: 0px 0px 0px 8px;
  font: "Noto Sans Medium 12";
}

element-icon {
  size: 5em; 
}

element selected normal {
  background-color: @accent;
}
